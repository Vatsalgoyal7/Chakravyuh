rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    
    function isSuperAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc().role == 'super_admin'; }
    function isCategoryAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc().role == 'admin'; }
    function isCoordinator() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc().role == 'coordinator'; }
    function isGeneralAdmin() { return isCategoryAdmin() && (!('adminCategory' in userDoc()) || userDoc().adminCategory == 'General' || userDoc().adminCategory == 'general'); }
    function isSportsAdmin() { return isCategoryAdmin() && ('adminCategory' in userDoc()) && (userDoc().adminCategory == 'Sports' || userDoc().adminCategory == 'sports'); }
    
    function managesEvent(eventId) { return (isCoordinator() || isSportsAdmin()) && eventId in userDoc().assignedSports; }
    function canManageEventRegistrations(eventId) { return isSuperAdmin() || isGeneralAdmin() || managesEvent(eventId); }
    function isAdmin() { return isSuperAdmin() || isCategoryAdmin() || isCoordinator(); }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin() || isCategoryAdmin());
      allow create: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isSuperAdmin() || (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt', 'phone', 'rollNo', 'branch', 'residency', 'roomNo']));
      allow delete: if isSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (managesEvent(eventId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rules', 'venue', 'coordinators', 'image', 'registrationDeadline', 'isActive', 'updatedAt']));
    }

    match /registrations/{registrationId} {
      allow create: if exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.status == 'pending'
        && request.resource.data.trackingCode is string
        && !request.resource.data.keys().hasAny(['approvedBy', 'approvedAt', 'checkedIn', 'checkedInAt']);
      allow get, list, update, delete: if canManageEventRegistrations(resource.data.eventId);
    }

    match /registration_status/{trackingCode} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.trackingCode == trackingCode
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['trackingCode', 'eventId', 'eventTitle', 'sportType', 'teamName', 'status', 'registeredAt', 'checkedIn']);
      allow update, delete: if canManageEventRegistrations(resource.data.eventId);
    }

    // Dynamic operations categories rules
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Operations chat room rules
    match /messages/{messageId} {
      allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
      allow read: if signedIn() && (
        isSuperAdmin() || 
        resource.data.senderUid == request.auth.uid || 
        resource.data.recipientId == request.auth.uid || 
        resource.data.recipientId.endsWith("_group")
      );
      allow update, delete: if isSuperAdmin() || (signedIn() && resource.data.senderUid == request.auth.uid);
    }

    match /gallery/{imageId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /notifications/{notificationId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /contacts/{contactId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /rules_general/{ruleId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /schedules/{scheduleId} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{settingId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /faqs/{faqId} { allow read: if true; allow write: if isSuperAdmin() || isAdmin(); }
    match /activity_logs/{logId} { allow read: if isSuperAdmin(); allow create: if signedIn(); allow update, delete: if isSuperAdmin(); }
    match /payment_verifications/{verificationId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || isGeneralAdmin() ||
        (isSportsAdmin() && get(/databases/$(database)/documents/registrations/$(resource.data.registrationId)).data.eventId in userDoc().assignedSports);
    }
    match /custom_forms/{formId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /about/{docId} { allow read: if true; allow write: if isSuperAdmin(); }
  }
}
